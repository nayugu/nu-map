ical codes established by their fields’ governing organizations. Students create novel case studies based on real-world events and extrapolate these ethical conversations into the “big ethical and moral issues” facing their fields in the near future (genetic engineering, energy production, etc.). Focuses on the value of lifelong learning through reflective practice, mentorship, professional organizations and conferences, and leadership opportunities in the field.","coreqs":[],"prereqs":[],"level":"undergrad","typicallyOffered":["fall","spring","summer"],"catalogUrl":"https://catalog.northeastern.edu/course-descriptions/eesc/","reviews":"https://ratemyhusky.com/courses/EESC3000","offerings":{"terms":{"202410":{"term":"Fall 2023","sections":2,"enrolled":42,"capacity":42},"202430":{"term":"Spring 2024","sections":2,"enrolled":48,"capacity":48},"202460":{"term":"Summer B 2024","sections":1,"enrolled":18,"capacity":20},"202510":{"term":"Fall 2024","sections":2,"enrolled":39,"capacity":40},"202530":{"term":"Spring 2025","sections":3,"enrolled":61,"capacity":61},"202540":{"term":"Summer A 2025","sections":1,"enrolled":15,"capacity":15},"202560":{"term":"Summer B 2025","sections":1,"enrolled":13,"capacity":15},"202610":{"term":"Fall 2025","sections":3,"enrolled":61,"capacity":60},"202630":{"term":"Spring 2026","sections":4,"enrolled":80,"capacity":80}},"typicalDays":[],"daysPct":{"M":0,"T":0,"W":0,"Th":0,"F":0},"meetingPatterns":[["async",100]],"campuses":["Online"],"formats":["Online"]},"instructors":{"fall":[{"name":"Cheryl Arruda","sharePct":29,"reviews":"https://ratemyhusky.com/professors/cheryl-arruda"},{"name":"Jacquelyn MacDonald","sharePct":29,"reviews":"https://ratemyhusky.com/professors/jacquelyn-macdonald"},{"name":"Corrine Condon","sharePct":27,"reviews":"https://ratemyhusky.com/professors/corrine-condon"},{"name":"Kristen Crovo","sharePct":15,"reviews":"https://ratemyhusky.com/professors/kristen-crovo"}],"spring":[{"name":"Jacquelyn MacDonald","sharePct":34,"re