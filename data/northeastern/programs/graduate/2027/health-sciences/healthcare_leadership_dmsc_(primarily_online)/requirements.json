  "footnotes": [
    {
      "marker": "1",
      "text": "Students who have not completed their thesis but have already registered for the required number of thesis hours, and have no remaining coursework to complete the degree, may register for Thesis Continuation—Half-Time (MSCI 7996) in their last semester (including summer term). There is a 1-semester-hour tuition charge for Thesis Continuation—Half-Time (MSCI 7996). Thesis Continuation may be taken only once.",
      "codes": [
        "MSCI 7996"
      ],
      "substitution": null
    },
    {
      "marker": "2",
      "text": "Additional expenses may be associated with the experience courses, which are offered on-ground in a weeklong experiential format.",
      "codes": [],
      "substitution": null
    },
    {
      "marker": "3",
      "text": "Some of the optional experiential learning experiences are limited to specific groups of medical or allied health professionals.",
      "codes": [],
      "substitution": null
    },
    {
      "marker": "4",
      "text": "One semester hour of Experiential Reflections: Bridging Theory and Experience (MSCI 5400) must be completed for each experience course. Experiential Reflections: Bridging Theory and Experience (MSCI 5400) may be taken concurrently or after the associated courses.",
      "codes": [
        "MSCI 5400"
      ],
      "substitution": null
    },
    {
      "marker": "5",
      "text": "Students who select AI Across the Health Sciences (HLTH 5800) (4 semester hours) vs. Workforce Metrics: Measuring, Comparing, and Privileging the Interprofessional Healthcare Team (MSCI 6002) (3 semester hours) will incur an additional 1-semester-hour cost beyond the total program credits.",
      "codes": [
        "HLTH 5800",
        "MSCI 6002"
      ],
      "substitution": null
    },
    {
      "marker": "6",
      "text": "Anatomy and Physiology I and II, or equivalent, and an exercise physiology or medical background are strongly recommended for the exercise science concentration.",
      "codes": [],
      "substitution": null
    },
    {
      "marker": "7",
      "text": "Physical Activity and Exercise: Prescription, Measurement, and Testing (EXSC 5210) is offered online with a four-day, on-campus, hands-on lab component in a low-residency format.",
      "codes": [
        "EXSC 5210"
      ],
      "substitution": null
    }
  ],
