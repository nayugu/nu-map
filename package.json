{
  "name": "neu-course-planner",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Nathan Gu and Matthew Gu",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ort-wasm.js && vite",
    "dev:up": "node scripts/copy-ort-wasm.js && node scripts/dev-daemon.mjs up",
    "dev:down": "node scripts/dev-daemon.mjs down",
    "dev:restart": "node scripts/copy-ort-wasm.js && node scripts/dev-daemon.mjs restart",
    "dev:status": "node scripts/dev-daemon.mjs status",
    "dev:log": "tail -f .dev/vite.log",
    "build": "node scripts/copy-ort-wasm.js && node scripts/build-programs-bundle.js && vite build",
    "data:programs-bundle": "node scripts/build-programs-bundle.js",
    "preview": "vite preview",
    "data:fetch": "node scripts/fetch-courses.js",
    "data:fetch:write": "node scripts/fetch-courses.js --write",
    "data:patch": "node scripts/apply-patches.js",
    "data:patch:write": "node scripts/apply-patches.js --write",
    "data:validate": "node scripts/validate-patches.js",
    "data:update": "node scripts/fetch-courses.js --write && node scripts/scrape-catalog.js --merge --write && node scripts/apply-patches.js --write && node scripts/merge-nupath.js --write",
    "data:nupath:merge": "node scripts/merge-nupath.js",
    "data:nupath:merge:write": "node scripts/merge-nupath.js --write",
    "data:scrape": "node scripts/scrape-catalog.js",
    "data:scrape:merge": "node scripts/scrape-catalog.js --merge",
    "data:scrape:write": "node scripts/scrape-catalog.js --merge --write",
    "data:scrape:rotate": "node scripts/scrape-catalog.js --rotate",
    "data:scrape:rotate:write": "node scripts/scrape-catalog.js --rotate --write",
    "data:nupath": "node scripts/fetch-nupath.js",
    "data:nupath:write": "node scripts/fetch-nupath.js --write",
    "data:nupath:tableau": "node scripts/fetch-nupath.js --tableau --write",
    "data:nupath:catalog": "node scripts/fetch-nupath.js --catalog --write",
    "data:nupath:apply": "node scripts/apply-nupath-map.js",
    "data:nupath:apply:write": "node scripts/apply-nupath-map.js --write",
    "data:majors": "node scripts/scrape-majors.js",
    "data:majors:write": "node scripts/scrape-majors.js --write",
    "data:majors:dry": "node scripts/scrape-majors.js --dry-run",
    "data:bind-plans": "node scripts/bind-plans.js",
    "data:bind-plans:write": "node scripts/bind-plans.js --write",
    "data:grad-majors": "node scripts/scrape-grad-majors.js",
    "data:grad-majors:write": "node scripts/scrape-grad-majors.js --write",
    "data:grad-majors:dry": "node scripts/scrape-grad-majors.js --dry-run",
    "data:equivalences": "node scripts/build-equivalences.js",
    "data:equivalences:write": "node scripts/build-equivalences.js --write",
    "data:term-windows": "node scripts/derive-term-windows.js",
    "data:term-windows:write": "node scripts/derive-term-windows.js --write",
    "data:verify": "node scripts/verify-majors.js --report",
    "data:verify:write": "node scripts/verify-majors.js --report --write",
    "data:verify:update": "node scripts/verify-majors.js --update",
    "verify:chart": "node scripts/verify-chart.js",
    "catalog:check": "node scripts/catalog-check-server.js",
    "dev:pw": "node scripts/generate-dev-password.js",
    "test": "npm run test:unit && npm run test:contract && npm run test:invariant",
    "test:unit": "cd test/unit && node --test",
    "test:contract": "cd test/contract && node --test",
    "test:invariant": "cd test/invariant && node --test",
    "test:mcp": "npm --prefix mcp-server test",
    "test:split": "npm --prefix cloudflare/stripe-split test",
    "test:live": "cd test/live && node --test",
    "test:browser": "cd test/browser && node --test",
    "test:all": "npm test && npm run test:mcp && npm run test:split && npm run test:live",
    "test:baseline:update": "node test/invariant/regen-baselines.mjs",
    "gen:donate-qr": "node scripts/gen-donate-qr.mjs",
    "logos": "node scripts/build-logos.js",
    "logos:check": "node scripts/build-logos.js --check"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "js-yaml": "^4.1.1",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "vite": "^5.4.11"
  }
}
