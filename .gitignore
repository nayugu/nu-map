node_modules/
dist/
public/ort/
.DS_Store
.mypy_cache/
*.py
.env.local
.env*.local
# Plain .env too, and wrangler's local-secrets file. Only `.env*.local` was
# ignored, so a `.env` or a `cloudflare/*/.dev.vars` holding a live Stripe or
# Cloudflare key would have been committed by an ordinary `git add`. Nothing
# like that has ever been tracked here; this is so it stays that way.
.env
.dev.vars
.dev.vars.*
test-results/
.vscode/settings.json
# Local miniflare emulator state (KV blobs, Durable Object SQLite, caches).
# Rewritten on every `wrangler dev`, so it dirties the tree constantly.
.wrangler/

# Detached dev server's pid file and log (npm run dev:up) — per-machine state.
.dev/

# Opt-in HTML cache for the catalog scrapers (CATALOG_HTML_CACHE=.cache/catalog).
# Development only — never enabled in CI, which must see the live catalog.
.cache/
