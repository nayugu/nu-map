# /about lived for a few hours on 2026-08-04 (sitemap + early crawls)
# before being renamed to /story — 301 both spellings so nothing rots.
# Browsers and crawlers request /favicon.ico unprompted; serve the logo
# there instead of letting it fall through to the SPA shell.
/favicon.ico /logo.png 200

/about https://numap.app/story 301
/about.html https://numap.app/story 301

# The data surface moved home on 2026-08-05: pages from
# /northeastern/ai/html/** to /data/**, JSON from /northeastern/ai/** to
# /data/json/**. Splats keep this to a handful of rules for ~13k URLs.
# Exact rules must precede their covering splats (first match wins).
/northeastern/ai/html /data 301
/northeastern/ai/html/ /data 301
/northeastern/ai/html/index /data 301
/northeastern/ai/html/programs /data/majors 301
/northeastern/ai/html/titles /data 301
/northeastern/ai/html/* /data/:splat 301
/northeastern/ai/sitemap.xml /data/sitemap.xml 301
/northeastern/ai /data/json/index.json 301
/northeastern/ai/* /data/json/:splat 301

# AI assistants and crawlers guess URL shapes like /courses/CS2000 or
# /api/... that were never real. Serve the data guide AT the guessed URL
# with a 200 rewrite (not a redirect: fetch-restricted AI tools refuse
# to follow a Location header to a URL they haven't seen). Bare and /*
# forms both listed - a splat does not match its own bare path.
# NOTE: /data/** is REAL content now and must never appear here.
# Rules run top-down, first match wins; real paths (/, /data, /assets/,
# /northeastern/) never match these prefixes.
/courses /llms.txt 200
/courses/* /llms.txt 200
/course /llms.txt 200
/course/* /llms.txt 200
/catalog /llms.txt 200
/catalog/* /llms.txt 200
/classes /llms.txt 200
/classes/* /llms.txt 200
/class /llms.txt 200
/class/* /llms.txt 200
/subjects /llms.txt 200
